# Local environment files
.env
.env.*
!.env.example

# Local Superpowers task artifacts (documentation under docs/superpowers/ is tracked)
/.superpowers/

# Streamlit secrets
.streamlit/secrets.toml

# Python artifacts and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test caches and reports
.pytest_cache/
.coverage
htmlcov/

# R5 trusted local model binaries (never commit or load from untrusted sources)
artifacts/models/**/preprocessor.pkl
artifacts/models/**/cox_model.pkl

# R6-P0 imported engineer model artifacts are reference-only and untrusted
cognivex_ml/models/*.pkl
