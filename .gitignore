# Local environment files
.env
.env.*
!.env.example

# Local Superpowers task artifacts (documentation under docs/superpowers/ is tracked)
/.superpowers/

# Streamlit secrets
.streamlit/secrets.toml

# Python artifacts and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test caches and reports
.pytest_cache/
.coverage
htmlcov/

# Canonical frozen inference binaries under artifacts/models/ are
# checksum-verified, tracked deployment assets. Do not add arbitrary or
# untrusted pickle files.

# R6-P0 imported engineer model artifacts are reference-only and untrusted
cognivex_ml/models/*.pkl

# Local AI handoff copies are reference-only. The selected 68-feature contract
# below remains tracked because Track B/C load it through a repository-relative path.
/ai_handoff_data/*
!/ai_handoff_data/v1/
/ai_handoff_data/v1/*
!/ai_handoff_data/v1/selected_features.txt
