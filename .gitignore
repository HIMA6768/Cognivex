# Local environment files
.env
.env.*
!.env.example

# Local Superpowers task artifacts (documentation under docs/superpowers/ is tracked)
/.superpowers/

# Streamlit secrets
.streamlit/secrets.toml

# Python artifacts and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Test caches and reports
.pytest_cache/
.coverage
htmlcov/

# Ignore generated or untrusted model binaries. The five named canonical R5,
# R6, and R7 inference artifacts below are checksum-verified tracked assets
# required by clean deployment clones.
artifacts/models/**/preprocessor.pkl
artifacts/models/**/cox_model.pkl
artifacts/models/**/pipeline.pkl
!artifacts/models/track_a/r5a-track-a-baseline-v1/preprocessor.pkl
!artifacts/models/track_a/r5a-track-a-baseline-v1/cox_model.pkl
!artifacts/models/track_b/r6-track-b-v1/preprocessor.pkl
!artifacts/models/track_b/r6-track-b-v1/cox_model.pkl
!artifacts/models/track_c/r7-track-c-v1/pipeline.pkl

# R6-P0 imported engineer model artifacts are reference-only and untrusted
cognivex_ml/models/*.pkl

# Local AI handoff copies are reference-only. The selected 68-feature contract
# below remains tracked because Track B/C load it through a repository-relative path.
/ai_handoff_data/*
!/ai_handoff_data/v1/
/ai_handoff_data/v1/*
!/ai_handoff_data/v1/selected_features.txt
