##############################################################################
# architecture_flow — .env.example
# Copy to .env in each service that needs it (ai_interface/, frontend/, etl/).
# Never commit the real .env. This file holds names + placeholder shapes only.
##############################################################################

# ---------------------------------------------------------------------------
# DATABASE — MongoDB Atlas (OLTP + native vector search)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-name>.mongodb.net/architecture_flow?retryWrites=true&w=majority
MONGODB_DB_NAME=architecture_flow
MONGODB_VECTOR_INDEX_NAME=embedding_index

# ---------------------------------------------------------------------------
# OBJECT STORAGE — Cloudflare R2 (S3-compatible data lake: claim photos)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=architecture-flow-claims
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<your-r2-public-domain>

# ---------------------------------------------------------------------------
# AI INTERFACE (FastAPI service on Render) — model + inference config
# ---------------------------------------------------------------------------
MODEL_ARTIFACT_URL=<github-release-or-r2-url-to-onnx-model>
MODEL_VERSION=1.0.0
PREPROCESSING_VERSION=1.0.0
INFERENCE_DEVICE=cpu
FAST_TRACK_SEVERITY_THRESHOLD=0.85
FAST_TRACK_TYPE_THRESHOLD=0.80
QUALITY_GATE_MIN_RESOLUTION_PX=224
QUALITY_GATE_BLUR_VARIANCE_MIN=100.0
QUALITY_GATE_BRIGHTNESS_MIN=25
QUALITY_GATE_BRIGHTNESS_MAX=230

# ---------------------------------------------------------------------------
# APP BACKEND / FRONTEND (Next.js on Vercel)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://<your-render-service>.onrender.com
NEXT_PUBLIC_APP_ENV=development
API_INTERNAL_SECRET=<shared-secret-between-frontend-and-ai_interface>

# ---------------------------------------------------------------------------
# ETL (Render Cron Job)
# ---------------------------------------------------------------------------
ETL_SCHEDULE_CRON=0 2 * * *
ETL_BATCH_SIZE=500

# ---------------------------------------------------------------------------
# OPTIONAL — RAG / hosted embeddings (only if used beyond image embeddings)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=<only-if-rag-uses-hosted-embeddings-or-llm>
# COHERE_API_KEY=<alternative-embedding-provider>

# ---------------------------------------------------------------------------
# MONITORING / KEEP-ALIVE
# ---------------------------------------------------------------------------
CRON_PING_URL=https://<your-render-service>.onrender.com/health
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# DEPLOYMENT META (informational — not read by app code)
# ---------------------------------------------------------------------------
# Vercel: frontend/, backend (if folded into frontend/api)
# Render: ai_interface/, etl/ (cron job)
# Do NOT commit real values above. Populate the actual .env per-service
# directly in Vercel/Render's environment variable dashboards.
